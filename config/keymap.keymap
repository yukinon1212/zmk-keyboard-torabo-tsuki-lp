#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * バックスペースの連続削除（キーリピート）を有効にするための設定。
 *
 * 親指の &lt 2 BACKSPACE はレイヤータップで、長押しするとレイヤー2に
 * 切り替わってしまうため BSPC がリピートしない。quick-tap-ms を設定すると
 * 「一度タップした直後（200ms以内）に押し直して長押しした場合はタップ側
 * （= BSPC）を継続する」という挙動になり、連続削除ができるようになる。
 *
 * 操作方法: バックスペースを 1 回叩いてから、すぐ押しっぱなしにする。
 */

&lt { quick-tap-ms = <200>; };

/*
 * 日本語配列（JIS）で「~」を入力するための設定。
 *
 * ZMK のキーコードは US 配列基準の HID コードなので、OS 側が JIS 配列だと
 * 記号の対応がずれる。
 *   &kp TILDE  = Shift + HID 0x35（US の ` / ~ キー）
 *                → JIS では「半角/全角」キーなので何も入力されない
 *   &kp TILDE2 = Shift + HID 0x32（Non-US #）
 *                → JIS では「}」になる
 *   &kp LS(EQUAL) = Shift + HID 0x2E
 *                → JIS の「^」キー + Shift = 「~」  ← これが正解
 *
 * 同じ理由で JIS では以下も読み替えが必要:
 *   ` (バッククォート) = &kp LS(LBKT)   @ = &kp LBKT
 *   | (パイプ)         = &kp LS(INT_YEN)
 *   " (ダブルクォート) = &kp LS(N2)     ' = &kp LS(N7)
 */

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        esc_combo {
            bindings = <&kp ESC>;
            key-positions = <52 58>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3    &kp N4     &kp N5                                 &kp N6     &kp N7  &kp N8    &kp N9    &kp N0       &kp BSPC
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T                                  &kp Y      &kp U   &kp I     &kp O     &kp P        &kp BSPC
&kp CAPS   &kp A      &kp S     &kp D     &kp F      &kp G      &mkp LCLK  &mkp RCLK        &kp H      &kp J   &kp K     &kp L     &kp MINUS    &kp SQT
&kp BSPC   &kp Z      &kp X     &kp C     &kp V      &kp B      &kp SPACE  &kp RET          &kp N      &kp M   &mkp MB1  &mkp MB2  &mkp MB3     &kp RSHFT
&kp LCTRL  &kp LCTRL  &kp LGUI  &kp LALT  &kp LSHFT  &kp SPACE  &mo 1      &lt 2 BACKSPACE  &kp ENTER  &trans  &trans    &trans    &lt 3 GRAVE  &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans      &trans               &trans            &trans            &trans                            &trans  &trans     &trans      &trans    &trans         &trans
&trans  &kp N1      &kp N2               &kp N3            &kp N4            &kp N5                            &kp N6  &kp N7     &kp N8      &kp N9    &kp N0         &trans
&trans  &kp TAB     &kp SEMICOLON        &kp SINGLE_QUOTE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp B  &trans  &trans  &mkp LCLK  &kp INSERT  &kp HOME  &kp PAGE_UP    &trans
&trans  &kp DELETE  &kp COMMA            &kp DOT           &kp FSLH          &kp BACKSLASH      &kp A  &trans  &trans  &trans     &trans      &kp END   &kp PAGE_DOWN  &trans
&trans  &kp ESCAPE  &kp INTERNATIONAL_1  &kp INT_YEN       &trans            &trans             &kp C  &trans  &trans  &trans     &trans      &trans    &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans          &trans     &trans        &trans     &trans         &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6          &kp F7     &kp F8        &kp F9     &kp F10        &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &kp LEFT_BRACE  &kp MINUS  &kp UP_ARROW  &kp F11    &kp F12        &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &kp LS(MINUS)   &kp LEFT   &kp DOWN      &kp RIGHT  &kp BACKSLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp TAB         &kp DEL    &trans        &trans     &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans  &trans      &trans                   &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4      &kp F5                   &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_CLR  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9      &kp F10  &trans  &trans  &kp LEFT          &kp DOWN      &kp UP_ARROW  &kp RIGHT      &kp TAB     &trans
&trans  &kp F11  &kp F12  &trans  &trans      &trans   &trans  &trans  &kp SINGLE_QUOTE  &kp DQT       &kp GRAVE     &kp LS(EQUAL)  &kp PIPE    &trans
&trans  &trans   &trans   &trans  &kp DELETE  &kp TAB  &trans  &trans  &trans            &trans        &trans        &trans         &trans      &trans
            >;
        };
    };
};
